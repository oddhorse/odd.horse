---
title: Style Test Page
layout: base
color: "#000000"
---

<style>
	/* Minimal page layout for testing - NO component overrides */
	main {
		max-width: 1200px;
		margin: 0 auto;
		padding: 2rem;
	}
	section {
		margin: 4rem 0;
		padding: 2rem;
		border: 1px dashed var(--lighter-text-color);
	}
	h2 {
		margin-bottom: 1rem;
		color: var(--lighter-text-color);
	}
</style>

{% include "header.njk" %}

<main>
	<h1>Global Style Test Page</h1>
	<p>This page displays all global components in their DEFAULT state, without page-specific overrides.</p>

	<section>
		<h2>Semantic HTML Elements</h2>
		<p>This is a paragraph with <a href="#">a link</a> and <strong>strong text</strong>.</p>
		<h1>Heading 1</h1>
		<h2>Heading 2</h2>
		<h3>Heading 3</h3>
		<ul>
			<li>List item one</li>
			<li>List item two</li>
		</ul>
	</section>

	<section>
		<h2>Logo Container (Default Size)</h2>
		<p>This should be 5rem (global default), NOT 7rem (homepage override).</p>
		<div class="logo-container">
			{% include "icons/OH-thick.svg" %}
			<span class="logo-tagline">test tagline</span>
		</div>
	</section>

	<section>
		<h2>Utility Classes</h2>
		<p class="oddhorse-inline">oddhorse inline style</p>
		<p class="emoticon">:3</p>
		<p class="darker">darker text</p>
	</section>

	<section>
		<h2>Animations</h2>
		<p>Check that animations like floatUpDown and fadeOutSustain work if triggered.</p>
	</section>
</main>

{% include "footer.njk" %}
