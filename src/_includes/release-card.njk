<div class="release-card">
    <h2>{{ title }}</h2>
    <img src="{{ img }}" alt="{{ title }} cover" class="img-fluid">
    <p>release date: {{ date }}</p>
    {# if >1 producer say producers #}
    <p>producer{% if producers.length > 1 %}s{% endif %}: {% for name in producers %}
            {{ name }}
            {# add comma (>2) or & (2) between names #}
            {% if loop.index < producers.length %}
                {% if producers.length > 2 %}, {% else %} & {% endif %}
            {% endif %}
        {% endfor %}
    </p>
</div>