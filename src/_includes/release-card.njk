<div class="release-card">
    <h2>{{ title }}</h2>
    <img src="{{ img }}" alt="{{ title }} cover" class="img-fluid">
    <p>release date:
        {{ date }}</p>
    {# if >1 producer say producers #}
    {% if not producers %}
        {% set producers = "oddhorse" %}
    {% endif %}
    {% if producers is not string %}
        <p>producers:
            {% for name in producers %}
                {{ name }}
                {# add comma (>2) or & (2) between names #}
                {% if not loop.last %}
                    {% if producers.length > 2 %},
                    {% else %}
                        &
                    {% endif %}
                {% endif %}
            {% endfor %}
        </p>
    {% elif producers is string %}
        <p>producer:
            {{ producers }}</p>
    {% endif %}
</div>