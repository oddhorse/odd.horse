{# Beta menu - only shown on beta branch #}
{% if gitInfo.branch != "main" %}
	<div class="beta-menu">
		<button class="beta-menu-toggle" aria-label="Toggle beta menu">
			<span class="beta-label">BETA</span>
		</button>
		<div class="beta-menu-content">
			<h3>beta tools</h3>
			<button class="beta-button" id="clear-clicks">clear click data</button>
			<button class="beta-button" id="add-dummy-artifact">add dummy artifact</button>
			<hr style="border: 1px solid var(--lighter-text-color); margin: 0.75rem 0;">
			<h4 style="margin: 0.5rem 0; font-size: 0.875rem;">background</h4>
			<button class="beta-button" id="bg-diagonal">diagonal scroll</button>
			<button class="beta-button" id="bg-horizontal">horizontal scroll</button>
			<button class="beta-button" id="bg-vertical">vertical scroll</button>
			<button class="beta-button" id="bg-rotate">rotate</button>
			<button class="beta-button" id="bg-pause">pause/resume</button>
			<p class="beta-info" id="fps-counter">fps: 60</p>
			<p class="beta-info">git branch: <a href="https://github.com/oddhorse/odd.horse/tree/{{ gitInfo.branch }}" target="_blank">{{ gitInfo.branch }}</a>
			</p>
			<p class="beta-info">commit: <a href="https://github.com/oddhorse/odd.horse/commit/{{ gitInfo.commit }}" target="_blank">{{ gitInfo.shortcommit }}</a>
			</p>
		</div>
	</div>

	<style>
		/* Beta menu container - fixed to top right */
		.beta-menu {
			position: fixed;
			top: 1rem;
			right: 1rem;
			z-index: 1000;
		}

		/* Toggle button */
		.beta-menu-toggle {
			background: red;
			color: white;
			border: 2px solid var(--text-color);
			padding: 0.5rem 0.75rem;
			font-family: "FT88", sans-serif;
			font-size: 0.875rem;
			font-weight: bold;
			cursor: pointer;
			user-select: none;
			transition: transform 0.2s ease;
		}

		.beta-menu-toggle:hover {
			transform: scale(1.05);
		}

		.beta-label {
			display: block;
		}

		/* Menu content - hidden by default */
		.beta-menu-content {
			position: absolute;
			top: 100%;
			right: 0;
			margin-top: 0.5rem;
			background: var(--background-color);
			border: 2px solid var(--text-color);
			padding: 1rem;
			min-width: 200px;
			display: none;
		}

		.beta-menu.open .beta-menu-content {
			display: block;
		}

		.beta-menu-content h3 {
			margin: 0 0 0.75rem;
			font-size: 1rem;
			font-weight: bold;
		}

		/* Beta buttons */
		.beta-button {
			display: block;
			width: 100%;
			background: var(--background-color);
			color: var(--text-color);
			border: 1px solid var(--text-color);
			padding: 0.5rem;
			margin-bottom: 0.5rem;
			cursor: pointer;
			font-family: inherit;
			font-size: 0.875rem;
			transition: background-color 0.2s ease, color 0.2s ease;
		}

		.beta-button:hover {
			background: var(--text-color);
			color: var(--background-color);
		}

		/* Info text */
		.beta-info {
			font-size: 0.75rem;
			color: var(--lighter-text-color);
			margin: 0.25rem 0;
			font-family: monospace;
		}
	</style>

	<script type="module" src="/assets/js/beta-menu.js"></script>
{% endif %}