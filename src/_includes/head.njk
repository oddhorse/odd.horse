<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }}</title>
	<meta name="theme-color" content="{{ color }}">

	{# ========================
	   EDITABLE HEAD SECTIONS
	   The blocks below are grouped and clearly commented so you can adapt them.
	   - SEO / social: description, canonical, og, twitter
	   - Performance: preconnect, preload LCP image
	   - PWA / mobile: apple meta, mask-icon
	   - Security / privacy: referrer-policy, color-scheme
	   Edit values or remove blocks as needed.
	======================== #}

	<!-- === SEO (editable) === -->
	<meta name="description" content="{{ description | default(meta.description | default('')) }}">
	<link rel="canonical" href="{{ site.url | default('') }}{{ page.url }}">
	{# hide pages from indexing #}
	{% if noindex %}
		<meta name="robots" content="noindex, nofollow">
	{% else %}
		<meta name="robots" content="index, follow">
	{% endif %}
	<!-- === /SEO === -->

	<!-- === Social (Open Graph & Twitter) === -->
	<meta property="og:type" content="{{ og.type | default('website') }}">
	<meta property="og:title" content="{{ og.title | default(title) }}">
	<meta property="og:description" content="{{ og.description | default(description | default(meta.description | default(''))) }}">
	<meta property="og:image" content="{{ og.image | default(ogImage | default(meta.ogImage | default(''))) }}">
	<meta property="og:url" content="{{ (site.url | default('')) }}{{ page.url }}">
	<meta property="og:site_name" content="{{ site.title | default('') }}">

	<meta name="twitter:card" content="{{ twitter.card | default('summary_large_image') }}">
	<meta name="twitter:site" content="{{ site.twitter | default('') }}">
	<meta name="twitter:title" content="{{ twitter.title | default(title) }}">
	<meta name="twitter:description" content="{{ twitter.description | default(description | default(meta.description | default(''))) }}">
	<meta name="twitter:image" content="{{ twitter.image | default(og.image | default(ogImage | default(meta.ogImage | default('')))) }}">
	<!-- === /Social === -->

	<!-- === Performance Hints (editable) === -->
	{# Keep your critical font preloads (present below). Add preconnects for external origins you use. #}
	{% if site.preconnect %}
		{% for host in site.preconnect %}
			<link rel="preconnect" href="{{ host }}" crossorigin>
		{% endfor %}
	{% endif %}

	{# Preload a Largest Contentful Paint image if you set `page.lcpImage` in frontmatter #}
	{% if page.lcpImage %}
		<link rel="preload" as="image" href="{{ page.lcpImage }}" imagesrcset="{{ page.lcpImageSrcset | default('') }}" imagesizes="{{ page.lcpImageSizes | default('') }}" fetchpriority="high">
	{% endif %}
	<!-- === /Performance === -->

	<!-- === PWA & Mobile (editable) === -->
	<link rel="icon" type="image/x-icon" href="/assets/favicon/favicon.ico">
	<link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
	<link rel="manifest" href="/site.webmanifest">

	<meta name="apple-mobile-web-app-capable" content="yes">
	<meta name="apple-mobile-web-app-status-bar-style" content="default">
	<link rel="mask-icon" href="/assets/favicon/safari-pinned.svg" color="{{ color | default('#000000') }}">
	<!-- === /PWA & Mobile === -->

	<!-- === Security & Privacy (editable) === -->
	<meta name="referrer" content="strict-origin-when-cross-origin">
	<meta name="color-scheme" content="light dark">
	<meta name="format-detection" content="telephone=no">
	<!-- Note: set CSP and other hard security headers at the server level; inline scripts may require CSP hashes/nonces. -->
	<!-- === /Security & Privacy === -->

	{# Main stylesheet - plain CSS with modern features #}
	<link rel="stylesheet" href="/assets/css/main.css">
	{# bundled CSS placeholder removed — using external stylesheet link above #}

	{# Keep preloading the project's fonts (critical) #}
	<link rel="preload" href="/assets/fonts/Karrik-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous">
	<link rel="preload" href="/assets/fonts/Karrik-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

	{# Main JavaScript - ES module with navbar, colors, artifact tracking #}
	<script type="module" src="/assets/js/main.js"></script>
	{# bundled JS placeholder removed — using external module script src above #}

	{# Set page color variable - defaults to black if not defined #}
	<script>
		document
			.documentElement
			.style
			.setProperty("--page-color", "{{ color or '#000000' }}");
	</script>
	{# if it isn't local dev server, add gtag #}
	{% if eleventy.env.runMode != 'serve' %}
		{% include "gtag.njk" %}
	{% endif %}

</head>