<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <meta name="theme-color" content="{{ color }}">

    <link rel="preload" href="/assets/fonts/Karrik-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous">
    <link rel="preload" href="/assets/fonts/Karrik-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

    <!-- favicon stuff -->

    <link rel="icon" type="image/x-icon" href="/assets/favicon/favicon.ico">
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <!-- (android-chrome favicon assignments are in site.webmanifest !) -->

    {# Main stylesheet - plain CSS with modern features #}
    <link rel="stylesheet" href="/assets/css/main.css">
    {# add bundled css #}
    {% getBundle "css" %}

    {# Main JavaScript - ES module with navbar, colors, artifact tracking #}
    <script type="module" src="/assets/js/main.js"></script>
    {# add bundled js #}
    {% getBundle "js" %}

    {# Set page color variable - defaults to black if not defined #}
    <script>
        document
            .documentElement
            .style
            .setProperty("--page-color", "{{ color or '#000000' }}");
    </script>
    {# if it isn't local dev server, add gtag #}
    {% if eleventy.env.runMode != 'serve' %}
        {% include "gtag.njk" %}
    {% endif %}
</head>