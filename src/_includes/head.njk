<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }}</title>
	<meta name="theme-color" content="{{ color }}">

	{# Page values resolved once here so the tags below stay readable.
	   Per-page frontmatter (description, ogImage) wins; meta.json is the fallback. #}
	{% set pageUrl = meta.url + page.url %}
	{% set pageDescription = description or meta.description %}
	{% set pageImage = ogImage or (meta.url + meta.ogImage) %}

	<!-- === SEO === -->
	<meta name="description" content="{{ pageDescription }}">
	<link rel="canonical" href="{{ pageUrl }}">
	{# noindex: true in frontmatter hides a page from search engines #}
	<meta name="robots" content="{% if noindex %}noindex, nofollow{% else %}index, follow{% endif %}">

	<!-- === Social (Open Graph & Twitter) === -->
	<meta property="og:type" content="website">
	<meta property="og:title" content="{{ title }}">
	<meta property="og:description" content="{{ pageDescription }}">
	<meta property="og:image" content="{{ pageImage }}">
	<meta property="og:url" content="{{ pageUrl }}">
	<meta property="og:site_name" content="{{ meta.title }}">
	<meta property="og:locale" content="{{ meta.locale }}">

	{# No Twitter/X account, so twitter:site is omitted deliberately.
	   These tags still drive the link preview card on X and elsewhere. #}
	<meta name="twitter:card" content="summary_large_image">
	<meta name="twitter:title" content="{{ title }}">
	<meta name="twitter:description" content="{{ pageDescription }}">
	<meta name="twitter:image" content="{{ pageImage }}">

	<!-- === Performance Hints === -->
	{# Preload the two Karrik weights used for body text (FT88 is display-only
	   and loads late enough that preloading it would compete with these). #}
	<link rel="preload" href="/assets/fonts/Karrik-Italic.woff2" as="font" type="font/woff2" crossorigin="anonymous">
	<link rel="preload" href="/assets/fonts/Karrik-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous">

	{# Prefetch internal artifact pages — the whole site is a list of these,
	   so a click is likely and these are cheap same-origin fetches.
	   External origins are deliberately NOT preconnected: they sit behind
	   modals most visitors never open, and 7 idle TLS handshakes cost more
	   than they save. #}
	{% for artifact in artifacts %}
		{% if artifact.url and artifact.url != '#' and not artifact.url.startsWith('http') and not artifact.hidden %}
			<link rel="prefetch" href="{{ artifact.url }}">
		{% endif %}
	{% endfor %}

	<!-- === Favicons === -->
	<link rel="icon" type="image/x-icon" href="/assets/favicon/favicon.ico">
	<link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon/favicon-32x32.png">
	<link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon/favicon-16x16.png">
	<link rel="apple-touch-icon" href="/assets/favicon/apple-touch-icon.png">

	<!-- === Security & Privacy === -->
	{# Hard security headers (CSP etc.) belong at the server, not here. #}
	<meta name="referrer" content="strict-origin-when-cross-origin">
	<meta name="color-scheme" content="light">
	<meta name="format-detection" content="telephone=no">

	{# Main stylesheet - plain CSS with modern features #}
	<link rel="stylesheet" href="/assets/css/main.css">

	{# Core JavaScript - ES module loaded on ALL pages (logo hover, modals) #}
	<script type="module" src="/assets/js/core.js"></script>

	{# Set page color before first paint, so nothing flashes the default.
	   Deliberately NOT a module: modules defer, which would be too late. #}
	<script>
		document.documentElement.style.setProperty("--page-color", "{{ color or '#000000' }}");
	</script>

	{# Skip analytics on the local dev server #}
	{% if eleventy.env.runMode != 'serve' %}
		{% include "gtag.njk" %}
	{% endif %}
</head>
