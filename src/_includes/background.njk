{# background code - fully self-contained #}

<canvas id="background"></canvas>

<style>
	#background {
		/* places bg under everything, takes up whole page */
		position: fixed;
		inset: 0;
		z-index: -999;
		pointer-events: none;
		overflow: hidden;
		width: 100vw;
		height: 100vh;

		/* crisp pixel art rendering */
		image-rendering: -moz-crisp-edges;
		image-rendering: -webkit-crisp-edges;
		image-rendering: pixelated;
		image-rendering: crisp-edges;

		/* performance hints - tells browser to optimize this layer */
		will-change: contents;
		contain: strict;

		/* starts background invisible */
		opacity: 0;
		transition: opacity 2s ease-in-out;
	}
</style>

<script type="module" src="/assets/js/background.js"></script>
