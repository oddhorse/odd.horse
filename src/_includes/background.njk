{# background code - fully self-contained #}

<div id="background">
    {% include "horses/horse.svg" %}
</div>

<style>
    #background {
        /* places bg under everything, takes up whole page */
        position: absolute;
        inset: 0;
        z-index: -999;
        pointer-events: none;

        /* starts background invisible */
        opacity: 0;
        transition: opacity 2s ease-in-out;
    }
</style>

<script type="module">
    /* background — isolated ES‑module to avoid globals and build‑time interference */

    const bg = document.getElementById("background");

    (() => {
        const horses = {
            0: {
                name: "Thunder Hooves",
                img: "https://placekitten.com/600/400",
                posx: 10,
                posy: 10
            },
            1: {
                name: "Celestial Mane",
                img: "https://placebear.com/600/400",
                posx: 20,
                posy: 20
            }
        };

        /* Wait for DOM to be fully loaded */
        document.addEventListener("DOMContentLoaded", () => {
            bg.style.opacity = 1;
        });

        function spawnHorse(data) {
            bg.
        }

    })();
</script>
