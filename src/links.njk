---
title: links
layout: base
---

{# Page-specific styles for links page #}
<style>
	.links-page {
		max-width: 600px;
		margin: 0 auto;
		padding: 2rem 1rem;
	}

	.links-page h1 {
		text-align: center;
		margin-bottom: 2rem;
	}

	.links-list {
		list-style: none;
		padding: 0;
	}

	.links-list li {
		margin: 1rem 0;
	}

	.links-list a {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem;
		text-decoration: none;
		color: var(--text-color);
		transition: color var(--link-hover-transition-speed);
		font-size: 1.2rem;
	}

	.links-list a:hover {
		color: var(--link-color, var(--link-hover-color));
	}

	.links-list .link-icon {
		font-size: 1.5rem;
	}
</style>

<main class="links-page">
	<h1>links</h1>

	<ul class="links-list">
	{% for name, data in links %}
		<li>
			<a href="{{ data.url }}"
				 target="_blank"
				 rel="noopener noreferrer"
				 style="--link-color: {{ data.color }};">
				<span class="link-icon">{{ data.icon }}</span>
				<span class="link-name">{{ name }}</span>
			</a>
		</li>
	{% endfor %}
	</ul>
</main>
