---
title: Layout 2 - Modern Card-Based
layout: base
---

{# Layout 2: Modern Card-Based Design #}
<div class="release-layout-2">
    <div class="hero-section">
        <div class="hero-content">
            <div class="release-meta">
                <span class="project-number">#{{ project_number or "03" }}</span>
                <span class="release-type-badge">{{ release_type or "EP" }}</span>
                {% if collaborators %}
                <span class="collaboration">feat. {{ collaborators }}</span>
                {% endif %}
            </div>
            
            <h1 class="hero-title">{{ title or "Release Title" }}</h1>
            
            <div class="hero-stats">
                <div class="stat-item">
                    <span class="stat-label">Released</span>
                    <span class="stat-value">{{ date or "Jun 2025" }}</span>
                </div>
                <div class="stat-item">
                    <span class="stat-label">Duration</span>
                    <span class="stat-value">{{ length or "3:42" }}</span>
                </div>
                {% if track_count and track_count > 1 %}
                <div class="stat-item">
                    <span class="stat-label">Tracks</span>
                    <span class="stat-value">{{ track_count }}</span>
                </div>
                {% endif %}
            </div>
            
            <p class="hero-description">{{ description or "Ethereal melodies meet digital decay in this introspective journey through modern loneliness." }}</p>
        </div>
        
        <div class="hero-artwork">
            <div class="artwork-container">
                <img src="{{ img or '/assets/images/releases/placeholder.jpg' }}" alt="{{ title }} cover" class="main-artwork" sizes="350px">
                {% if necklace %}
                <div class="necklace-indicator">
                    <span class="necklace-dot"></span>
                    <span class="necklace-text">+ Physical</span>
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="cards-container">
        <div class="card streaming-card">
            <h2 class="card-title">Stream & Download</h2>
            <div class="streaming-grid">
                <a href="{{ spotify_link or '#' }}" class="stream-button spotify">
                    <span class="platform-name">Spotify</span>
                    <span class="platform-arrow">→</span>
                </a>
                <a href="{{ apple_link or '#' }}" class="stream-button apple">
                    <span class="platform-name">Apple Music</span>
                    <span class="platform-arrow">→</span>
                </a>
                <a href="{{ release_link or '#' }}" class="stream-button universal">
                    <span class="platform-name">All Platforms</span>
                    <span class="platform-arrow">→</span>
                </a>
            </div>
        </div>

        <div class="card description-card">
            <h2 class="card-title">About</h2>
            <div class="description-content">
                <p>{{ detailed_description or "Born from late-night sessions in a converted basement studio, this release captures the liminal space between connection and isolation. Each track explores different facets of digital-age relationships." }}</p>
                <p>{{ additional_description or "The sound palette draws from early 2000s electronica while incorporating contemporary production techniques, creating something that feels both nostalgic and forward-looking." }}</p>
            </div>
        </div>

        <div class="card lyrics-card">
            <h2 class="card-title">Lyrics & Meaning</h2>
            <div class="lyrics-interactive">
                <div class="lyrics-viewer">
                    <div class="verse-block" data-verse="1">
                        <div class="lyric-line annotated" data-annotation="Digital interference metaphor">
                            Walking through the static noise
                        </div>
                        <div class="lyric-line annotated" data-annotation="Memory preservation theme">
                            Finding fragments of your voice
                        </div>
                        <div class="lyric-line">
                            Between the pixels and the pain
                        </div>
                        <div class="lyric-line">
                            Nothing here will feel the same
                        </div>
                    </div>
                    
                    <div class="verse-block" data-verse="2">
                        <div class="lyric-line">
                            Chorus lines would go here
                        </div>
                        <div class="lyric-line annotated" data-annotation="Technology dependence">
                            Scrolling through the endless feed
                        </div>
                        <div class="lyric-line">
                            Looking for what I might need
                        </div>
                    </div>
                </div>
                
                <div class="annotation-popup" id="annotation-popup">
                    <div class="annotation-content"></div>
                </div>
            </div>
        </div>

        <div class="card process-card">
            <h2 class="card-title">Process & Behind the Scenes</h2>
            <div class="process-content">
                <div class="process-timeline">
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <h3>Writing</h3>
                            <p>{{ writing_process or "Initial sketches recorded on phone voice memos during late-night walks" }}</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <h3>Recording</h3>
                            <p>{{ recording_process or "Layered over 3 months using vintage Tascam 4-track and Logic Pro X" }}</p>
                        </div>
                    </div>
                    <div class="timeline-item">
                        <div class="timeline-dot"></div>
                        <div class="timeline-content">
                            <h3>Mixing</h3>
                            <p>{{ mixing_process or "Mixed through SSL console emulation with analog tape saturation" }}</p>
                        </div>
                    </div>
                </div>
                
                <div class="media-gallery">
                    <div class="media-grid">
                        <div class="media-thumbnail">
                            <img src="{{ process_image_1 or '/assets/images/placeholder-studio.jpg' }}" alt="Studio" sizes="150px">
                            <div class="media-overlay">Studio Setup</div>
                        </div>
                        <div class="media-thumbnail">
                            <img src="{{ process_image_2 or '/assets/images/placeholder-gear.jpg' }}" alt="Equipment" sizes="150px">
                            <div class="media-overlay">Recording Chain</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.release-layout-2 {
    max-width: 1200px;
    margin: 0 auto;
    font-family: system-ui, -apple-system, sans-serif;
}

.hero-section {
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 4rem;
    margin-bottom: 4rem;
    min-height: 500px;
    align-items: center;
}

.release-meta {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
    align-items: center;
}

.project-number {
    font-size: 0.9rem;
    font-weight: 600;
    color: #666;
    font-family: monospace;
}

.release-type-badge {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
}

.collaboration {
    font-size: 0.9rem;
    color: #888;
    font-style: italic;
}

.hero-title {
    font-size: 4rem;
    font-weight: 800;
    margin: 0 0 2rem 0;
    line-height: 0.9;
    background: linear-gradient(135deg, #333 0%, #666 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero-stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2rem;
}

.stat-item {
    display: flex;
    flex-direction: column;
}

.stat-label {
    font-size: 0.8rem;
    color: #888;
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.05em;
}

.stat-value {
    font-size: 1.2rem;
    font-weight: 700;
    color: #333;
}

.hero-description {
    font-size: 1.2rem;
    line-height: 1.6;
    color: #555;
    max-width: 500px;
}

.hero-artwork {
    display: flex;
    justify-content: center;
}

.artwork-container {
    position: relative;
    width: 350px;
    height: 350px;
}

.main-artwork {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 20px 40px rgba(0,0,0,0.15);
}

.necklace-indicator {
    position: absolute;
    top: -10px;
    right: -10px;
    background: #ff6b6b;
    color: white;
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.necklace-dot {
    width: 8px;
    height: 8px;
    background: white;
    border-radius: 50%;
}

.cards-container {
    display: grid;
    gap: 2rem;
}

.card {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    border: 1px solid #f0f0f0;
}

.card-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    color: #333;
}

.streaming-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
}

.stream-button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.2s ease;
    border: 2px solid transparent;
}

.stream-button.spotify {
    background: #1db954;
    color: white;
}

.stream-button.apple {
    background: #000;
    color: white;
}

.stream-button.universal {
    background: #f0f0f0;
    color: #333;
    border-color: #ddd;
}

.stream-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0,0,0,0.15);
}

.description-content p {
    margin-bottom: 1rem;
    line-height: 1.7;
    color: #555;
}

.lyrics-interactive {
    position: relative;
}

.verse-block {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: #f9f9f9;
    border-radius: 8px;
    border-left: 4px solid #667eea;
}

.lyric-line {
    display: block;
    margin-bottom: 0.5rem;
    line-height: 1.8;
    font-size: 1.1rem;
}

.lyric-line.annotated {
    cursor: pointer;
    position: relative;
    color: #667eea;
    font-weight: 500;
}

.lyric-line.annotated:hover {
    background: #e8f2ff;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
}

.annotation-popup {
    position: absolute;
    background: #333;
    color: white;
    padding: 1rem;
    border-radius: 8px;
    max-width: 300px;
    display: none;
    z-index: 10;
    font-size: 0.9rem;
    line-height: 1.4;
}

.process-timeline {
    margin-bottom: 2rem;
}

.timeline-item {
    display: flex;
    gap: 1rem;
    margin-bottom: 2rem;
    align-items: flex-start;
}

.timeline-dot {
    width: 12px;
    height: 12px;
    background: #667eea;
    border-radius: 50%;
    margin-top: 0.5rem;
    flex-shrink: 0;
}

.timeline-content h3 {
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: #333;
}

.timeline-content p {
    color: #666;
    line-height: 1.6;
    margin: 0;
}

.media-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
}

.media-thumbnail {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    aspect-ratio: 16/9;
}

.media-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.media-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.8));
    color: white;
    padding: 1rem;
    font-size: 0.9rem;
    font-weight: 600;
}

@media (max-width: 768px) {
    .hero-section {
        grid-template-columns: 1fr;
        gap: 2rem;
        text-align: center;
    }
    
    .hero-title {
        font-size: 3rem;
    }
    
    .artwork-container {
        width: 280px;
        height: 280px;
    }
    
    .streaming-grid {
        grid-template-columns: 1fr;
    }
}
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const annotatedLines = document.querySelectorAll('.lyric-line.annotated');
    const popup = document.getElementById('annotation-popup');
    
    annotatedLines.forEach(line => {
        line.addEventListener('click', function(e) {
            const annotation = this.getAttribute('data-annotation');
            const popupContent = popup.querySelector('.annotation-content');
            popupContent.textContent = annotation;
            
            popup.style.display = 'block';
            popup.style.left = e.pageX + 10 + 'px';
            popup.style.top = e.pageY - 10 + 'px';
        });
    });
    
    document.addEventListener('click', function(e) {
        if (!e.target.matches('.lyric-line.annotated')) {
            popup.style.display = 'none';
        }
    });
});
</script>