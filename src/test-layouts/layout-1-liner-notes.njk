---
title: Layout 1 - Classic Liner Notes
layout: base
---

{# Layout 1: Classic Album Liner Notes Style #}
<div class="release-layout-1">
    <header class="release-header">
        <div class="release-title-block">
            <h1 class="release-title">{{ title or "Release Title" }}</h1>
            <div class="release-subtitle">
                <span class="release-type">Project #{{ project_number or "3" }} · {{ release_type or "EP" }}</span>
                {% if collaborators %}
                <span class="collaborators">with {{ collaborators }}</span>
                {% endif %}
            </div>
        </div>
        <div class="release-artwork">
            <img src="{{ img or '/assets/images/releases/placeholder.jpg' }}" alt="{{ title }} cover" class="cover-art" sizes="250px">
            {% if necklace %}
            <div class="necklace-info">
                <span class="necklace-tag">+ necklace available</span>
            </div>
            {% endif %}
        </div>
    </header>

    <section class="release-info-grid">
        <div class="release-card-section">
            <div class="info-panel">
                <dl class="release-details">
                    <dt>Released</dt>
                    <dd>{{ date or "June 18, 2025" }}</dd>
                    
                    <dt>Duration</dt>
                    <dd>{{ length or "3:42" }}</dd>
                    
                    {% if track_count and track_count > 1 %}
                    <dt>Tracks</dt>
                    <dd>{{ track_count }} songs</dd>
                    {% endif %}
                </dl>
                
                <div class="short-description">
                    <p>{{ description or "A haunting exploration of digital loneliness wrapped in shimmering synths and confessional vocals." }}</p>
                </div>

                <div class="streaming-links-liner">
                    <h3>Listen</h3>
                    <div class="platform-links">
                        <a href="{{ spotify_link or '#' }}" class="platform-link spotify">Spotify</a>
                        <a href="{{ apple_link or '#' }}" class="platform-link apple">Apple Music</a>
                        <a href="{{ release_link or '#' }}" class="platform-link other">All Platforms</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="detailed-description">
        <h2>About This Release</h2>
        <div class="description-content">
            <p>{{ detailed_description or "This release explores themes of connection and isolation in the digital age. Written during late-night sessions in a converted garage studio, these tracks blend organic instrumentation with electronic textures, creating a sound that feels both intimate and expansive." }}</p>
            <p>{{ additional_description or "The production combines vintage analog warmth with contemporary digital precision, featuring field recordings from abandoned buildings and manipulated vocal samples." }}</p>
        </div>
    </section>

    <section class="lyrics-section">
        <h2>Lyrics</h2>
        <div class="lyrics-annotated">
            <div class="lyrics-column">
                <div class="verse">
                    <div class="line-group">
                        <span class="lyric-line">Walking through the static noise</span>
                        <span class="annotation" data-note="References digital interference as metaphor for communication breakdown">*</span>
                    </div>
                    <div class="line-group">
                        <span class="lyric-line">Finding fragments of your voice</span>
                        <span class="annotation" data-note="Memories preserved in digital formats">*</span>
                    </div>
                    <div class="line-group">
                        <span class="lyric-line">Between the pixels and the pain</span>
                    </div>
                    <div class="line-group">
                        <span class="lyric-line">Nothing here will feel the same</span>
                    </div>
                </div>
            </div>
            <div class="annotations-panel">
                <h3>Annotations</h3>
                <div class="annotation-notes">
                    <p><strong>Line 1:</strong> References digital interference as metaphor for communication breakdown</p>
                    <p><strong>Line 2:</strong> Memories preserved in digital formats</p>
                </div>
            </div>
        </div>
    </section>

    <section class="process-media">
        <h2>Process & Media</h2>
        <div class="process-grid">
            <div class="process-text">
                <h3>Recording Process</h3>
                <p>{{ process_description or "Recorded over three months in a makeshift home studio. Primary instruments included a vintage Jazzmaster, Moog Sub 37, and various found percussion. All vocals were captured using a single SM57 for consistency." }}</p>
                
                <h3>Production Notes</h3>
                <ul>
                    <li>{{ production_note_1 or "Tape saturation added using Studer A800 plugin" }}</li>
                    <li>{{ production_note_2 or "Reverb created by recording in a concrete stairwell" }}</li>
                    <li>{{ production_note_3 or "Final mix printed to 1/4\" tape for analog warmth" }}</li>
                </ul>
            </div>
            <div class="process-media-gallery">
                <div class="media-item">
                    <img src="{{ studio_photo_1 or '/assets/images/placeholder-studio.jpg' }}" alt="Studio setup" sizes="(max-width: 768px) 100vw, 300px">
                    <caption>Home studio setup during recording</caption>
                </div>
                <div class="media-item">
                    <img src="{{ studio_photo_2 or '/assets/images/placeholder-gear.jpg' }}" alt="Recording equipment" sizes="(max-width: 768px) 100vw, 300px">
                    <caption>Primary recording chain</caption>
                </div>
            </div>
        </div>
    </section>
</div>

<style>
.release-layout-1 {
    max-width: 900px;
    margin: 0 auto;
    font-family: 'Times New Roman', serif;
    line-height: 1.6;
}

.release-header {
    display: flex;
    gap: 2rem;
    margin-bottom: 3rem;
    border-bottom: 2px solid #333;
    padding-bottom: 2rem;
}

.release-title-block {
    flex: 1;
}

.release-title {
    font-size: 3rem;
    font-weight: 300;
    margin: 0;
    letter-spacing: -0.02em;
}

.release-subtitle {
    font-size: 1.1rem;
    color: #666;
    margin-top: 0.5rem;
}

.release-artwork {
    width: 250px;
    position: relative;
}

.cover-art {
    width: 100%;
    border: 1px solid #ddd;
}

.necklace-tag {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    color: #888;
    margin-top: 0.5rem;
}

.release-info-grid {
    margin-bottom: 3rem;
}

.info-panel {
    background: #f9f9f9;
    padding: 2rem;
    border-left: 4px solid #333;
}

.release-details {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 2rem;
    margin-bottom: 2rem;
}

.release-details dt {
    font-weight: bold;
    color: #333;
}

.release-details dd {
    margin: 0;
    color: #666;
}

.short-description {
    font-style: italic;
    margin-bottom: 2rem;
    font-size: 1.1rem;
}

.streaming-links-liner h3 {
    margin-bottom: 1rem;
    font-size: 1.2rem;
}

.platform-links {
    display: flex;
    gap: 1rem;
}

.platform-link {
    padding: 0.5rem 1rem;
    border: 2px solid #333;
    text-decoration: none;
    color: #333;
    font-weight: bold;
    transition: all 0.2s;
}

.platform-link:hover {
    background: #333;
    color: white;
}

section {
    margin-bottom: 3rem;
}

section h2 {
    font-size: 2rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
    padding-bottom: 0.5rem;
}

.lyrics-annotated {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
}

.lyrics-column {
    font-family: 'Georgia', serif;
    font-size: 1.1rem;
    line-height: 2;
}

.line-group {
    position: relative;
    margin-bottom: 0.5rem;
}

.annotation {
    color: #0066cc;
    cursor: help;
    font-weight: bold;
    margin-left: 0.5rem;
}

.annotations-panel {
    background: #f5f5f5;
    padding: 1.5rem;
    border-radius: 4px;
}

.annotation-notes p {
    margin-bottom: 1rem;
    font-size: 0.9rem;
    line-height: 1.4;
}

.process-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
}

.process-text ul {
    padding-left: 1.5rem;
}

.process-text li {
    margin-bottom: 0.5rem;
}

.process-media-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.media-item img {
    width: 100%;
    border: 1px solid #ddd;
}

.media-item caption {
    display: block;
    text-align: center;
    font-size: 0.9rem;
    color: #666;
    margin-top: 0.5rem;
}

@media (max-width: 768px) {
    .release-header,
    .lyrics-annotated,
    .process-grid {
        grid-template-columns: 1fr;
    }
    
    .release-header {
        flex-direction: column;
    }
    
    .release-artwork {
        width: 100%;
        max-width: 300px;
    }
}
</style>