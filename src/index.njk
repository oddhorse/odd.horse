---
title: oddhorse
layout: base
---

{# Homepage-specific CSS and JavaScript #}
<link rel="stylesheet" href="/assets/css/pages/index.css">
<script type="module" src="/assets/js/homepage.js"></script>

{# Beta menu - only shows on beta branch #}
{% include "beta-menu.njk" %}

{# Modal system for contact and links #}
{% include "modals.njk" %}

{% include "header.njk" %}

<main>
	<ul class="artifact-list">
		{# Sort artifacts by date, newest first #}
		{% for artifact in artifacts | sort(reverse = true, attribute = 'dateAdded') %}
			{% if not artifact.hidden %}
				{# data-tags / data-image carry content metadata for the particle
				   system. Nothing renders them yet - they are data only.
				   Tags are space-separated so CSS can match one with
				   [data-tags~="music"], no JS needed. #}
				<li class="artifact-item"
				data-artifact-id="{{ artifact.id }}"
				data-date-added="{{ artifact.dateAdded }}"
				{%- if artifact.tags %} data-tags="{{ artifact.tags | join(' ') }}"{% endif %}
				{%- if artifact.image %} data-image="{{ artifact.image }}"{% endif %}
				{%- if artifact.imageAlt %} data-image-alt="{{ artifact.imageAlt }}"{% endif %}>
					<span class="artifact-badge artifact-badge-clicked">SEEN</span>
					<span class="artifact-badge artifact-badge-new">NEW!</span>
					<a href="{{ artifact.url }}"
					class="artifact-link"
					{% if artifact.newtab %}
						target="_blank"
						rel="noopener noreferrer"
					{% endif %}
					style="--hover-color: {{ artifact.color or '#ff00bb' }};">
						<span class="artifact-status"></span>
						<span class="artifact-description">{{ artifact.description }}</span>
						<span class="artifact-date">{{ artifact.dateAdded }}</span>
					</a>
				</li>
			{% endif %}
		{% endfor %}
	</ul>
</main>

{% include "footer.njk" %}

