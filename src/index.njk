---
title: oddhorse
layout: base
---

{# Page-specific styles for homepage layout #}
<style>
	/* Body layout - flexbox container for vertical centering */
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		text-align: center;
	}

	/* Header takes only its content height, stays at top */
	header {
		flex: 0 0 auto;
		padding: 2rem 1rem 0;
	}

	/* Main fills remaining space and centers its content */
	main {
		flex: 1;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 0 1rem 2rem;
	}

	/* Logo customization for homepage */
	.logo-container {
		margin: 0 auto 1rem;
		--logo-size: 7rem;
		--tagline-size: 1.1rem;
	}

	.logo-container .logo {
		width: 5rem;
		height: auto;
	}

	/* Navbar spacing */
	.navbar {
		margin-bottom: 2rem;
	}

	/* ===== ARTIFACT LIST ===== */

	/**
	 * Artifact list on homepage
	 * Features click tracking with localStorage:
	 * - Hollow dot indicator for unclicked items
	 * - Filled dot for clicked items
	 * - "NEW" badge for items added within 30 days
	 * - "SEEN" badge for clicked items
	 * - Custom color per artifact via --artifact-color inline style
	 *
	 * JavaScript in artifacts.js handles:
	 * - Adding .clicked or .unclicked classes
	 * - Adding .new class for recent items
	 * - Saving click state to localStorage
	 */
	.artifact-list {
		list-style: none;
		padding: 2rem 0;
		margin: auto;
		text-align: left;
		width: 100%;
		max-width: 400px;
	}

	.artifact-item {
		margin: 0;
		position: relative;
		border: 1px solid var(--text-color);
	}

	/* Artifact link - flexbox layout with gap between elements */
	.artifact-link {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.5rem;
		text-decoration: none;
		color: var(--text-color);
		transition: color var(--link-hover-transition-speed);
	}

	.artifact-item.clicked .artifact-link {
		color: var(--lighter-text-color);
	}

	/* Hover changes to artifact's custom color */
	.artifact-item.clicked .artifact-link:hover,
	.artifact-link:hover {
		color: var(--artifact-color, var(--link-hover-color));
	}

	/* Hide the artifact status dot */
	.artifact-status {
		display: none;
	}

	.artifact-description {
		flex: 1;
		font-size: 1.1rem;
	}

	/* Date displayed after description - lighter, smaller, italic */
	.artifact-date {
		font-size: 0.85rem;
		font-style: italic;
		color: var(--lighter-text-color);
		margin-left: 0.5rem;
	}

	.artifact-item.clicked .artifact-date {
		color: var(--even-lighter-text-color);
	}

	/**
	 * "NEW" badge animations
	 * Pulse: Shrink and grow using sine wave
	 * Bob: Wave up and down vertically
	 */
	@keyframes badge-pulse {
		0%,
		100% {
			scale: 1;
		}
		50% {
			scale: 1.15;
		}
	}

	@keyframes badge-bob {
		0%,
		100% {
			translate: 0 0;
		}
		50% {
			translate: 0 -3px;
		}
	}

	/**
	 * "NEW" badge
	 * Positioned exactly on top right corner of artifact item
	 * Middle of text sits on the corner itself
	 * Hidden by default, shown only on items with .new class
	 */
	.artifact-badge-new {
		display: none;
		position: absolute;
		top: 0;
		right: 0;
		font-family: "FT88", sans-serif;
		font-size: 1rem;
		font-weight: bold;
		color: red;
		background: var(--background-color);
		transform: translate(50%, -50%) rotate(5deg);
		animation: badge-pulse 2s ease-in-out infinite, badge-bob 2s ease-in-out infinite;
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
		pointer-events: none;
		transition: transform 0.2s ease;
	}

	/* Badge reacts when link is hovered (badge itself has pointer-events: none) */
	.artifact-item:has(.artifact-link:hover) .artifact-badge-new {
		transform: translate(50%, -50%) rotate(5deg) scale(1.2);
		animation-play-state: paused;
	}

	.artifact-item.new .artifact-badge-new {
		display: block;
	}

	/**
	 * "SEEN" badge
	 * Shows on clicked artifacts, positioned at top right corner
	 * Hidden by default, shown only on items with .clicked class
	 */
	.artifact-badge-clicked {
		display: none;
		position: absolute;
		top: 0;
		right: 0;
		font-family: "FT88", sans-serif;
		font-size: 0.75rem;
		font-weight: bold;
		color: var(--lighter-text-color);
		background: var(--background-color);
		transform: translate(50%, -50%) rotate(5deg);
		user-select: none;
		-webkit-user-select: none;
		cursor: default;
		pointer-events: none;
		transition: transform 0.2s ease, color 0.2s ease;
	}

	/* Badge reacts when link is hovered (badge itself has pointer-events: none) */
	.artifact-item:has(.artifact-link:hover) .artifact-badge-clicked {
		transform: translate(50%, -50%) rotate(5deg) scale(1.1);
		color: var(--text-color);
	}

	.artifact-item.clicked .artifact-badge-clicked {
		display: block;
	}

	/* Hide NEW badge on clicked items, show SEEN instead */
	.artifact-item.clicked .artifact-badge-new {
		display: none;
	}

	/* Mobile: smaller text and reduced padding */
	@media (max-width: 768px) {
		.artifact-list {
			padding: 1rem 0;
		}

		.artifact-description {
			font-size: 1rem;
		}
	}

	/* Mobile adjustments */
	@media (max-width: 768px) {
		header {
			padding: 1rem 0.5rem 0;
		}

		main {
			padding: 0 0.5rem 1rem;
		}

		.logo-container {
			--logo-size: 4rem;
		}

		.logo-container .logo {
			width: 4rem;
		}
	}
</style>

{# Beta menu - only shows on beta branch #}
{% include "beta-menu.njk" %}

{# Modal system for contact and links #}
{% include "modals.njk" %}

{% include "header.njk" %}

<main>
	<ul class="artifact-list">
		{# Sort artifacts by date, newest first #}
		{% for artifact in artifacts | sort(reverse=true, attribute='dateAdded') %}
			<li class="artifact-item"
				data-artifact-id="{{ artifact.id }}"
				data-date-added="{{ artifact.dateAdded }}">
				<span class="artifact-badge artifact-badge-clicked">SEEN</span>
				<span class="artifact-badge artifact-badge-new">NEW!</span>
				<a href="{{ artifact.url }}"
					class="artifact-link"
					target="_blank"
					rel="noopener noreferrer"
					style="--artifact-color: {{ artifact.color or '#ff00bb' }};">
					<span class="artifact-status"></span>
					<span class="artifact-description">{{ artifact.description }}</span>
					<span class="artifact-date">{{ artifact.dateAdded }}</span>
				</a>
			</li>
		{% endfor %}
	</ul>
</main>

{# Artifact tracking - only used on homepage #}
<script type="module">
	import {initArtifactTracking, wipeClickData, refreshArtifactUI} from '/assets/js/artifacts.js'

	// Initialize artifact tracking on page load
	initArtifactTracking()

	// Expose functions to window for debugging and beta menu access
	window.wipeClickData = wipeClickData
	window.refreshArtifactUI = refreshArtifactUI
</script>

{% include "footer.njk" %}

