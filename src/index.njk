---
title: oddhorse
layout: base
---

{# Page-specific styles for homepage layout #}
<style>
	.homepage-container {
		text-align: center;
		padding: 2rem 1rem;
	}

	.homepage-container .logo-container {
		margin: 0 auto 1rem;
		--logo-size: 7rem;
		--tagline-size: 1.1rem;
	}

	.homepage-container .logo-container .logo {
		width: 5rem;
		height: auto;
	}

	.homepage-container .navbar {
		margin-bottom: 3rem;
	}

	.homepage-container .artifact-list {
		text-align: left;
	}

	/* Mobile adjustments */
	@media (max-width: 768px) {
		.homepage-container {
			padding: 1rem 0.5rem;
		}

		.homepage-container .logo-container {
			--logo-size: 4rem;
		}

		.homepage-container .logo-container .logo {
			width: 4rem;
		}
	}
</style>

<div class="homepage-container">

	{% include "navbar.njk" %}
	{% include "header-logo.njk" %}
	<ul class="artifact-list">
		{% for artifact in artifacts | reverse %}
			<li class="artifact-item"
				data-artifact-id="{{ artifact.id }}"
				data-date-added="{{ artifact.dateAdded }}">
				<span class="artifact-badge artifact-badge-clicked">SEEN</span>
				<span class="artifact-badge artifact-badge-new">NEW!</span>
				<a href="{{ artifact.url }}"
				 class="artifact-link"
				 target="_blank"
				 rel="noopener noreferrer"
				 style="--artifact-color: {{ artifact.color or '#ff00bb' }};">
					<span class="artifact-status"></span>
					<span class="artifact-description">{{ artifact.description }}</span>
					<span class="artifact-date">{{ artifact.dateAdded }}</span>
				</a>
			</li>
		{% endfor %}
	</ul>
</div>