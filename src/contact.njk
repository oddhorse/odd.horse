{# Page-specific styles for contact page with playful paragraph positioning #}
<style>
	.emoticon {
		color: #a0a0a0;
		scale: 1.4;
	}

	/* First paragraph - large greeting */
	main > p:first-of-type {
		margin-bottom: 3rem;
		text-align: right;
		margin-right: 10vw;
		font-size: 3rem;
	}

	/* Staggered paragraph positioning for visual interest */
	main > p:nth-of-type(2) {
		margin-top: 1.5rem;
		margin-bottom: 1.2rem;
		margin-left: 32%;
	}

	main > p:nth-of-type(3) {
		margin-top: 0.8rem;
		margin-bottom: 1.6rem;
		margin-left: 24%;
	}

	main > p:nth-of-type(4) {
		margin-top: 1.3rem;
		margin-bottom: 0.9rem;
		margin-left: 8%;
	}
</style>

<main class="contact-page">
