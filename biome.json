{
	"$schema": "https://biomejs.dev/schemas/2.0.6/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"javascript": {
		"formatter": {
			"semicolons": "asNeeded",
			"quoteStyle": "single"
		}
	},
	"json": {},
	"css": {
		"formatter": {
			"enabled": true,
			"indentWidth": 3
		}
	}
}
