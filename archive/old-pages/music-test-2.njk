---
title: music test 2 - card-based list
color: "#31ddff"
---

<style>
.music-cards {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    margin: 2rem 0;
}

.music-card {
    background: var(--background-color);
    border: 2px solid var(--lighter-text-color);
    border-radius: 8px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    align-items: stretch;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.music-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: var(--card-accent-color, var(--oddhorse-color));
}

.music-card:hover {
    border-color: var(--card-accent-color, var(--oddhorse-color));
    transform: translateY(-2px);
}

.card-image {
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 4px;
    min-height: 140px;
}

.card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 140px;
    justify-content: space-between;
}

.card-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
}

.card-title {
    font-size: 1.8rem;
    margin: 0;
    color: var(--text-color);
    line-height: 1.1;
}

.card-meta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
}

.card-type {
    background: var(--card-accent-color, var(--oddhorse-color));
    color: white;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05rem;
    font-weight: bold;
}

.card-year {
    font-size: 0.9rem;
    color: var(--lighter-text-color);
    font-style: italic;
}

.card-description {
    font-size: 0.95rem;
    color: var(--text-color);
    font-style: italic;
    margin: 0;
    line-height: 1.3;
}

.card-spotify {
    margin: 0.5rem 0;
    border-radius: 12px;
    overflow: hidden;
}

.card-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    gap: 0.5rem;
}

.card-button {
    padding: 0.5rem 0.8rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.8rem;
    text-align: center;
    transition: all 0.2s ease;
    border: 2px solid;
    background: transparent;
    font-weight: bold;
    text-transform: lowercase;
}

.card-button:hover {
    transform: scale(1.05);
}

.btn-spotify { 
    color: #1DB954; 
    border-color: #1DB954;
}
.btn-spotify:hover { 
    background: #1DB954; 
    color: white;
}

.btn-apple { 
    color: #FA57C1; 
    border-color: #FA57C1;
}
.btn-apple:hover { 
    background: #FA57C1; 
    color: white;
}

.btn-all { 
    color: var(--oddhorse-color); 
    border-color: var(--oddhorse-color);
}
.btn-all:hover { 
    background: var(--oddhorse-color); 
    color: white;
}

.btn-more { 
    color: var(--text-color); 
    border-color: var(--text-color);
}
.btn-more:hover { 
    background: var(--text-color); 
    color: var(--background-color);
}

@media screen and (max-width: 47.9375em) {
    .music-card {
        grid-template-columns: 1fr;
        text-align: center;
    }
    
    .card-image {
        justify-self: center;
    }
    
    .card-actions {
        grid-template-columns: 1fr 1fr;
    }
}
</style>

<h1>music - card-based list design</h1>

<div class="music-cards">
    {% for item in collections.releases | reverse %}
    <div class="music-card" style="--card-accent-color: {{ item.data.color }};">
        <img src="{{ item.data.img }}" alt="{{ item.data.title }} cover" class="card-image" sizes="140px">
        
        <div class="card-content">
            <div class="card-header">
                <h2 class="card-title">{{ item.data.title }}</h2>
                <div class="card-meta">
                    <span class="card-type">{{ item.data.tags | replace('releases', '') | replace(',,', ',') | replace('^,', '') | replace(',$', '') }}</span>
                    <span class="card-year">{{ item.data.date.split('/')[2] or '2024' }}</span>
                </div>
                <p class="card-description">haunting melodies meet synthetic textures in this intimate exploration</p>
            </div>
            
            {% if item.data.spotify_link %}
            <div class="card-spotify">
                {% set embedUrl = item.data.spotify_link | replace('track/', 'embed/track/') | replace('album/', 'embed/album/') | replace('?', '?utm_source=generator&theme=0&') %}
                <iframe style="border-radius:12px" src="{{ embedUrl }}" width="100%" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
            </div>
            {% endif %}
            
            <div class="card-actions">
                {% if item.data.spotify_link %}
                <a href="{{ item.data.spotify_link }}" target="_blank" class="card-button btn-spotify">spotify</a>
                {% endif %}
                {% if item.data.apple_link %}
                <a href="{{ item.data.apple_link }}" target="_blank" class="card-button btn-apple">apple</a>
                {% endif %}
                {% if item.data.release_link %}
                <a href="{{ item.data.release_link }}" target="_blank" class="card-button btn-all">all</a>
                {% endif %}
                <a href="{{ item.url }}" class="card-button btn-more">more info</a>
            </div>
        </div>
    </div>
    {% endfor %}
</div>