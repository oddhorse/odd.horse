---
title: music test 3 - minimal list
color: "#31ddff"
---

<style>
.minimal-music {
    margin: 3rem 0;
    max-width: 800px;
}

.music-entry {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(0,0,0,0.1);
    align-items: stretch;
}

.music-entry:hover {
    background: rgba(0,0,0,0.01);
}

.entry-image {
    height: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 2px;
    min-height: 80px;
}

.entry-details {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-height: 80px;
}

.entry-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
}

.entry-info h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: normal;
    color: var(--text-color);
    line-height: 1.2;
}

.entry-subtitle {
    font-size: 0.85rem;
    color: var(--lighter-text-color);
    margin: 0.2rem 0 0 0;
    display: flex;
    gap: 0.75rem;
}

.entry-year {
    font-style: italic;
}

.entry-tagline {
    font-size: 0.9rem;
    color: var(--text-color);
    margin: 0;
    font-style: italic;
    opacity: 0.8;
}

.entry-preview {
    margin: 0.5rem 0;
}

.entry-preview iframe {
    border-radius: 8px;
}

.entry-links {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.minimal-link {
    color: var(--link-color);
    text-decoration: none;
    font-size: 0.8rem;
    padding: 0.25rem 0.5rem;
    border-radius: 3px;
    transition: all 0.15s ease;
    border-bottom: 1px solid transparent;
}

.minimal-link:hover {
    border-bottom-color: currentColor;
    transform: translateY(-1px);
}

.link-spotify { color: #1DB954; }
.link-apple { color: #FA57C1; }
.link-all { color: var(--oddhorse-color); }
.link-more { color: var(--text-color); }

.entry-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.25rem;
    flex-shrink: 0;
}

.play-indicator {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--oddhorse-color);
    opacity: 0;
    transition: opacity 0.2s ease;
}

.music-entry:hover .play-indicator {
    opacity: 1;
}

@media screen and (max-width: 47.9375em) {
    .music-entry {
        grid-template-columns: auto 1fr;
        gap: 1rem;
        padding: 1rem 0;
    }
    
    .entry-image {
        min-height: 60px;
    }
    
    .entry-main {
        flex-direction: column;
        align-items: stretch;
        gap: 0.5rem;
    }
    
    .entry-actions {
        align-items: flex-start;
    }
    
    .entry-details {
        min-height: 60px;
    }
    
    .entry-subtitle {
        flex-direction: column;
        gap: 0.25rem;
    }
}

/* Ultra-minimal variant toggle */
.ultra-minimal .entry-preview {
    display: none;
}

.ultra-minimal .music-entry {
    padding: 0.75rem 0;
}

.ultra-minimal .entry-tagline {
    display: none;
}
</style>

<h1>music - minimal list design</h1>

<div class="minimal-music">
    {% for item in collections.releases | reverse %}
    <div class="music-entry">
        <img src="{{ item.data.img }}" alt="{{ item.data.title }} cover" class="entry-image" sizes="80px">
        
        <div class="entry-details">
            <div class="entry-main">
                <div class="entry-info">
                    <h3>{{ item.data.title }}</h3>
                    <div class="entry-subtitle">
                        <span class="entry-type">{{ item.data.tags | replace('releases', '') | replace(',,', ',') | replace('^,', '') | replace(',$', '') }}</span>
                        <span class="entry-year">{{ item.data.date.split('/')[2] or '2024' }}</span>
                    </div>
                    <p class="entry-tagline">delicate soundscapes for late night contemplation</p>
                </div>
                
                <div class="entry-actions">
                    <div class="play-indicator"></div>
                    <div class="entry-links">
                        {% if item.data.spotify_link %}
                        <a href="{{ item.data.spotify_link }}" target="_blank" class="minimal-link link-spotify">spotify</a>
                        {% endif %}
                        {% if item.data.apple_link %}
                        <a href="{{ item.data.apple_link }}" target="_blank" class="minimal-link link-apple">apple</a>
                        {% endif %}
                        {% if item.data.release_link %}
                        <a href="{{ item.data.release_link }}" target="_blank" class="minimal-link link-all">all</a>
                        {% endif %}
                        <a href="{{ item.url }}" class="minimal-link link-more">more</a>
                    </div>
                </div>
            </div>
            
            {% if item.data.spotify_link %}
            <div class="entry-preview">
                {% set embedUrl = item.data.spotify_link | replace('track/', 'embed/track/') | replace('album/', 'embed/album/') | replace('?', '?utm_source=generator&theme=0&') %}
                <iframe style="border-radius:8px" src="{{ embedUrl }}" width="100%" height="152" frameBorder="0" allowfullscreen="" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy"></iframe>
            </div>
            {% endif %}
        </div>
    </div>
    {% endfor %}
</div>

<script>
// Optional: Toggle ultra-minimal mode
document.addEventListener('keydown', function(e) {
    if (e.key === 'm' && e.ctrlKey) {
        document.querySelector('.minimal-music').classList.toggle('ultra-minimal');
    }
});
</script>