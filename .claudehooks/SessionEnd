#!/usr/bin/env bash

###############################################################################
# SessionEnd Hook - Eleventy Development Server Cleanup
###############################################################################
# This hook runs when a Claude Code session ends in this project.
# It gracefully shuts down the Eleventy dev server started by SessionStart.
#
# What it does:
# 1. Reads the PID from .dev-server.pid (saved by SessionStart)
# 2. Checks if that process is still running
# 3. Gracefully terminates the process (SIGTERM)
# 4. Cleans up PID file and log file
#
# This ensures clean shutdown and no orphaned processes.
###############################################################################

# Color output helpers
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# Path to PID file
PID_FILE="/Users/bear/Desktop/ODDHORSE SITE/.dev-server.pid"
LOG_FILE="/Users/bear/Desktop/ODDHORSE SITE/.dev-server.log"

echo -e "${GREEN}[SessionEnd Hook]${NC} Cleaning up Eleventy dev server..."

# Check if PID file exists
if [ ! -f "$PID_FILE" ]; then
    echo -e "${YELLOW}No dev server PID file found. Nothing to clean up.${NC}"
    exit 0
fi

# Read PID from file
SERVER_PID=$(cat "$PID_FILE")

# Check if process is still running
if ps -p $SERVER_PID > /dev/null 2>&1; then
    echo -e "${GREEN}Stopping dev server (PID: $SERVER_PID)...${NC}"

    # Send SIGTERM (graceful shutdown)
    kill $SERVER_PID

    # Wait for process to exit (max 10 seconds)
    for i in {1..10}; do
        if ! ps -p $SERVER_PID > /dev/null 2>&1; then
            echo -e "${GREEN}✓ Dev server stopped gracefully${NC}"
            break
        fi
        sleep 1
    done

    # Force kill if still running
    if ps -p $SERVER_PID > /dev/null 2>&1; then
        echo -e "${YELLOW}Force killing dev server...${NC}"
        kill -9 $SERVER_PID
    fi
else
    echo -e "${YELLOW}Dev server process not running (PID: $SERVER_PID)${NC}"
fi

# Clean up PID file
rm -f "$PID_FILE"

# Optional: Clean up log file (comment out if you want to keep logs)
# rm -f "$LOG_FILE"

echo -e "${GREEN}✓ Cleanup complete${NC}"
exit 0
