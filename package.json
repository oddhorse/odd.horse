{
	"name": "odd.horse",
	"version": "7.6",
	"type": "module",
	"description": "website for the music artist [oddhorse](https://odd.horse)",
	"scripts": {
		"start": "npx @11ty/eleventy --serve",
		"watch": "npx @11ty/eleventy --watch",
		"serve": "npx @11ty/eleventy --serve",
		"bench": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
		"build": "del-cli dist && npx @11ty/eleventy",
		"build-ghpages": "npx @11ty/eleventy --pathprefix=/odd.horse/",
		"start-ghpages": "npx @11ty/eleventy --pathprefix=/odd.horse/ --serve --quiet",
		"clean": "del-cli dist",
		"test": "echo \"Error: no test specified\" && exit 1",
		"prepare": "husky",
		"version:bump": "node scripts/bump-version.js",
		"compress": "node scripts/compress-images.js"
	},
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "git+https://oddhorse@github.com/oddhorse/odd.horse.git"
	},
	"author": "oddhorse (John Trinh)",
	"license": "ISC",
	"devDependencies": {
		"@11ty/eleventy": "^3.0.0",
		"@11ty/eleventy-img": "^4.0.2",
		"husky": "^9.1.7",
		"markdown-it": "^14.1.0",
		"markdown-it-anchor": "^9.2.0"
	},
	"dependencies": {
		"del-cli": "^6.0.0",
		"sharp": "^0.33.5",
		"simple-git": "^3.27.0"
	},
	"packageManager": "bun@1.3.8"
}
